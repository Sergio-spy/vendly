# Configuración de Odoo. Sin estas variables la app arranca en modo MOCK.
# En Vercel → Project → Settings → Environment Variables, añade las mismas claves.

ODOO_URL=https://tuempresa.odoo.com
ODOO_DB=tu-base-de-datos
ODOO_USER=api@tuempresa.com
ODOO_API_KEY=la-api-key-generada-en-el-perfil-del-usuario
